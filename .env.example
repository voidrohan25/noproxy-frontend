# ==============================================================================
# NOPROXY FRONTEND — VERCEL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Public URL of the deployed Render backend service (e.g. https://noproxy-backend.onrender.com)
# In local development, defaults to http://localhost:10000
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com

# Public application base URL
NEXT_PUBLIC_APP_URL=https://YOUR-FRONTEND.vercel.app

# Public Supabase Client credentials (client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sliding dynamic QR expiration in seconds (default: 20s)
NEXT_PUBLIC_QR_EXPIRY_SECONDS=20

# Demo mode flag (set to 'false' in production)
NEXT_PUBLIC_DEMO_MODE=true
